  "components": {
    "schemas": {
      "RegisterVoiceRequest": {
        "type": "object",
        "properties": {
          "file": {
            "type": [
              "string",
              "null"
            ],
            "format": "binary"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30,
            "minLength": 0
          },
          "consentAgreed": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "consentAgreed",
          "file",
          "name"
        ]
      },
      "CustomVoiceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SnsLoginRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "AppleLinkRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "nonce": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorizationCode": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "token"
        ]
      },
      "CreateDubbingJobRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "presetVoice": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SEOHYEON",
              "SEOYEON",
              "JINWOO",
              "TAEWOO"
            ]
          },
          "customVoiceId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "speed": {
            "type": "number",
            "format": "double",
            "maximum": 2.0,
            "minimum": 0.5
          }
        },
        "required": [
          "text"
        ]
      },
      "DubbingJobResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "text": {
            "type": "string"
          },
          "presetVoice": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SEOHYEON",
              "SEOYEON",
              "JINWOO",
              "TAEWOO"
            ]
          },
          "customVoiceId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "speed": {
            "type": "number",
            "format": "double"
          },
          "audioUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "AppleLoginRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "nonce": {
            "type": [
              "string",
              "null"
            ]
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "minLength": 0
          },
          "authorizationCode": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "token"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          }
        },
        "required": [
          "nickname"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "nickname": {
            "type": "string"
          },
          "profileImageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PresetVoiceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "VoicesResponse": {
        "type": "object",
        "properties": {
          "presets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresetVoiceResponse"
            }
          },
          "custom": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomVoiceResponse"
            }
          }
        }
      },
      "DubbingOptionsResponse": {
        "type": "object",
        "properties": {
          "voices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresetVoiceResponse"
            }
          },
          "speed": {
            "$ref": "#/components/schemas/SpeedOptionsResponse"
          },
          "maxTextLength": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SpeedOptionsResponse": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "format": "double"
          },
          "max": {
            "type": "number",
            "format": "double"
          },
          "default": {
            "type": "number",
            "format": "double"
          },
          "presets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeedPresetResponse"
            }
          }
        }
      },
      "SpeedPresetResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "PageResponseDubbingJobResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DubbingJobResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
